<?xml version="1.0" encoding="UTF-8"?>
<!--
    Persistence unit of the DataTable "Lazy JPA" example: an in-memory H2 database, created from scratch every
    time the application starts and filled by CustomerEntityService.

    No <provider> is named and every property below is a standard JPA one, so the unit runs on whichever
    provider is at hand - the one of the application server, or the Hibernate the "non-ee" build bundles for a
    plain servlet container.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="showcase" transaction-type="RESOURCE_LOCAL">
        <class>org.primefaces.showcase.domain.CustomerEntity</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:showcase;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
        </properties>
    </persistence-unit>
</persistence>
