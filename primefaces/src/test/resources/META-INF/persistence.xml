<?xml version="1.0" encoding="UTF-8"?>
<!--
    Persistence unit of JPALazyDataModelTest: an in-memory H2 database, recreated per test run, which lets the
    test assert what the criteria queries of JPALazyDataModel actually return instead of mocking JPA away.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="primefaces-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.primefaces.model.jpa.Employee</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:primefaces;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.show_sql" value="false"/>
            <!-- see NoJsonFormatMapper -->
            <property name="hibernate.type.json_format_mapper" value="org.primefaces.model.jpa.NoJsonFormatMapper"/>
        </properties>
    </persistence-unit>
</persistence>
