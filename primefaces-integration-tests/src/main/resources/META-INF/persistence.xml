<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="integration-test" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.primefaces.integrationtests.jpa.entity.CountryJpaEntity</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:integration-test;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <!-- Disable archive scanning to avoid NoSuchMethodError: Indexer.indexWithSummary
                 caused by Jandex 2.x (pulled in transitively by Weld 5.1.5 on Java 11)
                 conflicting with Hibernate 6.6 which requires Jandex 3.x.
                 Scanning is unnecessary here because all entity classes are explicitly listed above. -->
            <property name="hibernate.archive.scanner" value="org.hibernate.boot.archive.scan.internal.DisabledScanner"/>
        </properties>
    </persistence-unit>
    <!--
        Persistence unit of dataTable053.xhtml, the JPALazyDataModel test page: a separate in-memory H2
        database (own jdbc url), created from scratch every time the application starts.
    -->
    <persistence-unit name="integration-tests" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>org.primefaces.integrationtests.jpa.JpaEmployee</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:integrationtests;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <!-- jakartaee-api puts the Jakarta JSON Binding API on the classpath without an implementation,
                 which fails the boot if Hibernate picks that mapper; Jackson is available (via RESTEasy) -->
            <property name="hibernate.type.json_format_mapper" value="jackson"/>
        </properties>
    </persistence-unit>
</persistence>
